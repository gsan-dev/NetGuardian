# --- Sensor ---
NETWORK_INTERFACE=eth0
WINDOW_SECONDS=30
DISCOVERY_INTERVAL_SECONDS=15

# --- Base de datos ---
# Backend de persistencia: "sqlite" (por defecto) o "influxdb" (mejora futura).
DB_BACKEND=sqlite
DB_PATH=./data/netguardian.db
# Solo si DB_BACKEND=influxdb:
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=
INFLUXDB_ORG=netguardian
INFLUXDB_BUCKET=netguardian

# --- Modelo ML ---
# "global": un único Isolation Forest para toda la red.
# "per_ip": un modelo por IP/dispositivo (mejora futura ya integrada).
MODEL_MODE=global
MODEL_CONTAMINATION=0.05
MODEL_MIN_SAMPLES_PER_IP=50

# --- Notificaciones ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
NOTIFY_MIN_SEVERITY=medium
NOTIFY_COOLDOWN_SECONDS=300

# --- Bloqueo automático de IPs (mejora futura, deshabilitado por defecto) ---
AUTO_BLOCK_ENABLED=false
AUTO_BLOCK_MIN_SEVERITY=high
AUTO_BLOCK_WHITELIST=127.0.0.1,192.168.1.1
AUTO_BLOCK_DURATION_SECONDS=3600

# --- Backend / API ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# --- Autenticación del panel (mejora futura ya integrada) ---
AUTH_ENABLED=true
AUTH_SECRET_KEY=change-me-to-a-long-random-string
AUTH_TOKEN_EXPIRE_MINUTES=720
ADMIN_USERNAME=admin
# Hash bcrypt de la contraseña admin. Generar con:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'tu-password', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=

# --- Informes semanales en PDF (mejora futura ya integrada) ---
WEEKLY_REPORT_ENABLED=true
REPORTS_DIR=./reports
